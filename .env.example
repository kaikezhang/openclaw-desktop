# ===== OpenClaw Gateway (required) =====
# OpenClaw must be running locally. Install: npm install -g openclaw
# Device identity is auto-detected from ~/.openclaw/identity/device.json
OPENCLAW_PORT=18789
OPENCLAW_TOKEN=              # Optional: if gateway requires token auth

# ===== TTS — MiniMax (optional) =====
# Edge TTS (free) is used by default. MiniMax is optional fallback.
# Get your key at https://www.minimaxi.com/
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=speech-02-hd
MINIMAX_VOICE_ID=Chinese (Mandarin)_Warm_Girl

# ===== Image Generation (optional) =====
# Used for AI selfies and outfit generation
# Get your key at https://fal.ai/dashboard/keys
FAL_KEY=
