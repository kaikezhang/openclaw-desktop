# ===== Device Identity =====
# Auto-detected from ~/.openclaw/identity/device.json (no config needed)

# ===== OpenClaw Gateway =====
# Device identity is auto-detected from ~/.openclaw/identity/device.json
# No API key needed - uses Ed25519 key pair for authentication
OPENCLAW_PORT=18789
OPENCLAW_TOKEN=your_openclaw_token_here  # Optional: if gateway requires token auth

# ===== Deepgram STT =====
# Get your key at https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ===== MiniMax TTS =====
# Get your key at https://www.minimaxi.com/
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_GROUP_ID=your_minimax_group_id_here
MINIMAX_MODEL=speech-02-hd
MINIMAX_VOICE_ID=Lovely_Girl

# ===== fal.ai Image Generation =====
# Get your key at https://fal.ai/dashboard/keys
# FAL_KEY=your_fal_key_here
