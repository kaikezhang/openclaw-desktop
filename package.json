{
  "name": "openclaw-desktop",
  "version": "0.2.0",
  "description": "OpenClaw Desktop Assistant — AI voice assistant with Live2D avatar",
  "main": "dist/main/main.js",
  "bin": {
    "openclaw-desktop": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "tsc --watch & electron . --dev",
    "dev:build": "tsc --watch",
    "dev:electron": "electron . --dev",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "electron",
    "openclaw",
    "assistant",
    "ai",
    "voice",
    "live2d"
  ],
  "author": "OpenClaw",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@deepgram/sdk": "^4.11.3",
    "dotenv": "^17.2.4",
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.openclaw.desktop",
    "productName": "OpenClaw Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "assets/**/*",
      "!**/*.ts",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md}",
      "!**/node_modules/*/{test,__tests__,tests,example,examples}",
      "!**/node_modules/.bin"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
